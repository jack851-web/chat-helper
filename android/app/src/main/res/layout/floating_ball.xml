<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮球布局：支持两种视觉状态
     状态A（空闲/成功/失败）：圆形球 icon
     状态B（处理中）：横向圆角胶囊 + 加载文字 + 旋转图标
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ball_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- 联系人标签（悬浮球上方/下方显示当前选中联系人名字） -->
    <TextView
        android:id="@+id/ball_contact_label"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginTop="52dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/ball_contact_label_bg"
        android:text="联系人"
        android:textSize="10sp"
        android:textColor="#FFFFFF"
        android:maxEms="6"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone" />

    <!-- 状态A：圆形悬浮球（默认可见） -->
    <ImageView
        android:id="@+id/ball_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/ball_background"
        android:padding="10dp"
        android:src="@drawable/ic_chat_ball"
        android:contentDescription="Chat-Helper 悬浮球" />

    <!-- 状态B：横向加载条（默认隐藏，处理中显示） -->
    <LinearLayout
        android:id="@+id/ball_loading_bar"
        android:layout_width="160dp"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/ball_loading_bar_bg"
        android:visibility="gone">

        <!-- 旋转加载图标 -->
        <ProgressBar
            android:id="@+id/ball_loading_spinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminateTint="#FFFFFF" />

        <!-- 加载文字（支持动态更新：截图完成→识别对话→生成建议） -->
        <TextView
            android:id="@+id/ball_loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="识别中..."
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
