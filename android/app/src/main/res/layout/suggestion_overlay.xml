<?xml version="1.0" encoding="utf-8"?>
<!-- 建议卡片全局浮窗布局（PRD §5.3） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/suggestion_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:background="#E6000000"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_suggestion_card"
        android:padding="16dp">

        <!-- 倒计时进度条 -->
        <ProgressBar
            android:id="@+id/progress_countdown"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progress="100"
            android:progressTint="#6C5CE7" />

        <!-- 拖拽指示条 -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/handle_bar_bg" />

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_auto_awesome"
                app:tint="#6C5CE7" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="为你准备了 N 条回复建议"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A" />

            <TextView
                android:id="@+id/tv_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="8s"
                android:textSize="12sp"
                android:textColor="#999999" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 换一批按钮：用 ImageView + selectableItemBackgroundBorderless，规避 ImageButton 在低 API 上的 tint/attr 兼容问题 -->
            <ImageView
                android:id="@+id/btn_refresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_refresh"
                android:contentDescription="换一批"
                android:clickable="true"
                android:focusable="true" />

            <!-- 存入草稿按钮 -->
            <ImageView
                android:id="@+id/btn_save_draft"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_save_draft"
                android:contentDescription="存入草稿"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btn_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:contentDescription="关闭"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- 可滚动内容区：Scene + Insight + Suggestions 统一滚动，防止总高度超出屏幕导致顶部截断 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:maxHeight="400dp"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- Part 1: 场景 + 方向 -->
        <LinearLayout
            android:id="@+id/layout_scene"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:padding="14dp"
            android:background="@drawable/bg_scene_card"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 场景标签 -->
                <LinearLayout
                    android:id="@+id/tag_scene"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_scene_tag"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/iv_scene_icon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        app:tint="#6C5CE7" />

                    <TextView
                        android:id="@+id/tv_scene_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="场景 A · 待回复"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#6C5CE7" />
                </LinearLayout>

                <!-- 方向文字 -->
                <TextView
                    android:id="@+id/tv_direction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="方向思路..."
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:textColor="#6C5CE7DD"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- 场景描述 -->
            <TextView
                android:id="@+id/tv_scene_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="场景描述"
                android:textSize="12sp"
                android:textColor="#888888"
                android:visibility="gone" />
        </LinearLayout>

        <!-- V2 Part 1.5: 联系人画像摘要（contact_insight） -->
        <LinearLayout
            android:id="@+id/layout_insight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="@drawable/bg_insight_card"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_insight"
                    app:tint="#00BCD4"
                    android:contentDescription="联系人画像" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="联系人画像"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#00BCD4" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_insight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="基于全量历史的画像摘要..."
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.4"
                android:textColor="#1A1A1A" />
        </LinearLayout>

        <!-- Part 2: 建议列表容器（已在外层 ScrollView 内，无需独立滚动） -->
        <LinearLayout
            android:id="@+id/container_suggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        </LinearLayout> <!-- end of scroll content -->
        </ScrollView> <!-- end of scrollable area -->
    </LinearLayout>
</FrameLayout>
